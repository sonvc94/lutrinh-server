# Copy to deploy/.env (chmod 600: it holds the backup password). Read by docker compose and
# by deploy/*.sh. Never commit deploy/.env.

# --- Proxy mode (deploy/Caddyfile) ------------------------------------------------------
# 1. Public domain, automatic HTTPS: the domain's A/AAAA record points at this host and
#    ports 80 + 443 are open.
#      LUTRINH_SITE=lutrinh.example.com
#      LUTRINH_HTTP_PORT=80
#      LUTRINH_HTTPS_PORT=443
# 2. LAN, plain http on a port (admin only through an SSH tunnel to localhost, README):
#      LUTRINH_SITE=:80
#      LUTRINH_HTTP_PORT=8080
# 3. Cloudflare Tunnel (no public IP): start with `--profile tunnel`; in the Cloudflare
#    dashboard the public hostname's service is http://caddy:80.
#      LUTRINH_SITE=:80
#      LUTRINH_BIND=127.0.0.1
#      LUTRINH_TRUSTED_PROXIES=private_ranges
#      LUTRINH_CLIENT_IP_HEADERS=CF-Connecting-IP
#      CLOUDFLARE_TUNNEL_TOKEN=...
# Default below: mode 2 on port 8080.
LUTRINH_SITE=:80
LUTRINH_BIND=0.0.0.0
LUTRINH_HTTP_PORT=8080
LUTRINH_HTTPS_PORT=8443

# --- Admin login ------------------------------------------------------------------------
# Test phase: username + password only (README §4: `lutrinh admin set-password`). Set `on` to ask
# for the TOTP (or a backup code) again, then `docker compose -f deploy/compose.yaml up -d`.
LUTRINH_ADMIN_TOTP=off

# --- Data (page 06 §4): db/, media/, uploads/, backups/ ----------------------------------
# A host directory owned by uid 10001 (deploy/bootstrap.sh creates it).
LUTRINH_DATA_PATH=/var/lib/lutrinh

# Image tag; `LUTRINH_TAG=2026-11-10 docker compose build` keeps the old one for rollback.
LUTRINH_TAG=latest

# --- Off-host backup (D-21, deploy/backup.sh) -------------------------------------------
# Any restic repository: s3:https://…/bucket/lutrinh, b2:bucket:lutrinh, sftp:user@host:/path,
# or /repo-local = RESTIC_LOCAL_DIR on this host (another disk).
RESTIC_REPOSITORY=/repo-local
RESTIC_LOCAL_DIR=/mnt/backup/lutrinh-restic
# Keep a copy of this password somewhere else: without it the backup cannot be read.
RESTIC_PASSWORD=change-me
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
